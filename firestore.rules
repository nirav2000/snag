rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // Authentication UID is a credential mapping, not the permanent Snag
    // business identity. Each user owns a private profile containing a stable
    // snagUserId plus references to projects they can recover on another device.
    match /snag_users/{uid} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
      match /projects/{projectId} {
        allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
      }
    }
    function projectDoc(projectId) {
      return get(/databases/$(database)/documents/snag_projects/$(projectId));
    }
    function isOwner(projectId) {
      return signedIn() && projectDoc(projectId).data.ownerUid == request.auth.uid;
    }
    function isMember(projectId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/snag_projects/$(projectId)/members/$(request.auth.uid));
    }
    function memberData(projectId) {
      return get(/databases/$(database)/documents/snag_projects/$(projectId)/members/$(request.auth.uid)).data;
    }
    function isAdmin(projectId) {
      return isOwner(projectId) || (isMember(projectId) && memberData(projectId).admin == true);
    }
    function activeInvite(projectId, inviteId) {
      return inviteId is string
        && exists(/databases/$(database)/documents/snag_projects/$(projectId)/invites/$(inviteId))
        && get(/databases/$(database)/documents/snag_projects/$(projectId)/invites/$(inviteId)).data.active == true;
    }

    match /snag_projects/{projectId} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      // A signed-in client may test a random project ID before creating its own
      // project. Existing project documents remain owner/member-only.
      allow get: if signedIn() && (
        !exists(/databases/$(database)/documents/snag_projects/$(projectId))
        || isOwner(projectId)
        || isMember(projectId)
      );
      allow list: if false;
      allow update: if isAdmin(projectId);
      allow delete: if isOwner(projectId);

      match /members/{uid} {
        allow read: if isOwner(projectId) || isMember(projectId);
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.uid == request.auth.uid
          && (
            isOwner(projectId)
            || (
              activeInvite(projectId, request.resource.data.inviteId)
              && request.resource.data.role ==
                get(/databases/$(database)/documents/snag_projects/$(projectId)/invites/$(request.resource.data.inviteId)).data.role
              && request.resource.data.admin ==
                get(/databases/$(database)/documents/snag_projects/$(projectId)/invites/$(request.resource.data.inviteId)).data.admin
            )
          );
        allow update: if isAdmin(projectId)
          || (
            signedIn() && request.auth.uid == uid
            && resource.data.uid == request.auth.uid
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.admin == resource.data.admin
            && request.resource.data.inviteId == resource.data.inviteId
          );
        allow delete: if isOwner(projectId) || (signedIn() && request.auth.uid == uid);

        match /seen/{seenId} {
          allow read, write: if signedIn() && request.auth.uid == uid && isMember(projectId);
        }
      }

      match /invites/{inviteId} {
        allow get: if isAdmin(projectId)
          || (
            signedIn()
            && inviteId.matches('^[A-Za-z0-9_-]{32,120}$')
            && resource.data.active == true
          );
        allow list: if isAdmin(projectId);
        allow create, update, delete: if isAdmin(projectId);
      }

      match /snags/{snagId} {
        allow read, create, update: if isOwner(projectId) || isMember(projectId);
        allow delete: if isAdmin(projectId);

        match /updates/{updateId} {
          allow read, create, update: if isOwner(projectId) || isMember(projectId);
          allow delete: if isAdmin(projectId);
        }
      }

      match /private_notes/{noteId} {
        // Firestore rules are not post-query filters. Non-admin users may only
        // query documents constrained to their own authorUid.
        allow read: if isAdmin(projectId)
          || (isMember(projectId) && resource.data.authorUid == request.auth.uid);
        allow create: if isMember(projectId)
          && request.resource.data.authorUid == request.auth.uid;
        allow update: if isAdmin(projectId)
          || (
            isMember(projectId)
            && resource.data.authorUid == request.auth.uid
            && request.resource.data.authorUid == resource.data.authorUid
          );
        allow delete: if isAdmin(projectId)
          || (isMember(projectId) && resource.data.authorUid == request.auth.uid);
      }
    }
  }
}
