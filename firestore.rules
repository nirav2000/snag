rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function projectDoc(projectId){return get(/databases/$(database)/documents/snag_projects/$(projectId));}
  function isOwner(projectId){return signedIn() && projectDoc(projectId).data.ownerUid == request.auth.uid;}
  function hasMember(projectId){return signedIn() && exists(/databases/$(database)/documents/snag_projects/$(projectId)/members/$(request.auth.uid));}
  function memberData(projectId){return get(/databases/$(database)/documents/snag_projects/$(projectId)/members/$(request.auth.uid)).data;}
  function activeInvite(projectId,inviteId){return inviteId is string && exists(/databases/$(database)/documents/snag_projects/$(projectId)/invites/$(inviteId)) && get(/databases/$(database)/documents/snag_projects/$(projectId)/invites/$(inviteId)).data.active == true;}
  function isMember(projectId){return hasMember(projectId) && (memberData(projectId).role == 'owner' || activeInvite(projectId,memberData(projectId).inviteId));}
  function isAdmin(projectId){return isOwner(projectId) || (isMember(projectId) && memberData(projectId).admin == true);}
  function restricted(projectId){return projectDoc(projectId).data.accessModelVersion >= 2;}
  function canReadSnag(projectId){return isOwner(projectId) || (isMember(projectId) && (memberData(projectId).role != 'contractor' || !restricted(projectId) || request.auth.uid in resource.data.participantUids));}
  function canCreateSnag(projectId){return isOwner(projectId) || (isMember(projectId) && (memberData(projectId).role != 'contractor' || !restricted(projectId) || (request.auth.uid in request.resource.data.participantUids && request.resource.data.createdByUid == request.auth.uid)));}
  function canUpdateSnag(projectId){return isOwner(projectId) || (isMember(projectId) && (memberData(projectId).role != 'contractor' || !restricted(projectId) || (request.auth.uid in resource.data.participantUids && request.resource.data.participantUids == resource.data.participantUids && request.resource.data.assigneeId == resource.data.assigneeId)));}
  function canReadSnagById(projectId,snagId){let s=get(/databases/$(database)/documents/snag_projects/$(projectId)/snags/$(snagId));return isOwner(projectId) || (isMember(projectId) && (memberData(projectId).role != 'contractor' || !restricted(projectId) || request.auth.uid in s.data.participantUids));}
  match /snag_accounts/{accountId}{allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;allow read,update,delete: if signedIn() && resource.data.ownerUid == request.auth.uid;}
  match /snag_users/{uid}{allow read,create,update,delete: if signedIn() && request.auth.uid == uid;match /projects/{projectId}{allow read,create,update,delete: if signedIn() && request.auth.uid == uid;}}
  match /snag_review_feeds/{feedId}{allow get: if feedId.matches('^[A-Za-z0-9_-]{40,120}$') && resource.data.app == 'snag';allow list: if false;allow create: if signedIn() && request.resource.data.app == 'snag' && request.resource.data.ownerUid == request.auth.uid;allow update: if signedIn() && resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == resource.data.ownerUid && request.resource.data.app == 'snag';allow delete: if false;}
  match /snag_projects/{projectId}{
   allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
   allow get: if signedIn() && (!exists(/databases/$(database)/documents/snag_projects/$(projectId)) || isOwner(projectId) || isMember(projectId));
   allow list: if false;allow update: if isAdmin(projectId);allow delete: if isOwner(projectId);
   match /members/{uid}{allow read: if isAdmin(projectId) || (signedIn() && request.auth.uid == uid && (isOwner(projectId) || isMember(projectId)));allow create: if signedIn() && request.auth.uid == uid && request.resource.data.uid == request.auth.uid && (isOwner(projectId) || (activeInvite(projectId,request.resource.data.inviteId) && request.resource.data.role == get(/databases/$(database)/documents/snag_projects/$(projectId)/invites/$(request.resource.data.inviteId)).data.role && request.resource.data.admin == get(/databases/$(database)/documents/snag_projects/$(projectId)/invites/$(request.resource.data.inviteId)).data.admin));allow update: if isAdmin(projectId) || (signedIn() && request.auth.uid == uid && resource.data.uid == request.auth.uid && request.resource.data.uid == resource.data.uid && request.resource.data.role == resource.data.role && request.resource.data.admin == resource.data.admin && request.resource.data.inviteId == resource.data.inviteId);allow delete: if isOwner(projectId) || (signedIn() && request.auth.uid == uid);match /seen/{seenId}{allow read,write: if isAdmin(projectId) || (signedIn() && request.auth.uid == uid && isMember(projectId));}}
   match /invites/{inviteId}{allow get: if isAdmin(projectId) || (signedIn() && inviteId.matches('^[A-Za-z0-9_-]{32,120}$') && resource.data.active == true);allow list: if isAdmin(projectId);allow create,update,delete: if isAdmin(projectId);}
   match /snags/{snagId}{allow read: if canReadSnag(projectId);allow create: if canCreateSnag(projectId);allow update: if canUpdateSnag(projectId);allow delete: if isAdmin(projectId);match /updates/{updateId}{allow read,create: if canReadSnagById(projectId,snagId);allow update: if isAdmin(projectId) || (canReadSnagById(projectId,snagId) && resource.data.authorUid == request.auth.uid && request.resource.data.authorUid == resource.data.authorUid);allow delete: if isAdmin(projectId);}}
   match /private_notes/{noteId}{allow read: if isAdmin(projectId) || (isMember(projectId) && resource.data.authorUid == request.auth.uid);allow create: if isMember(projectId) && request.resource.data.authorUid == request.auth.uid;allow update: if isAdmin(projectId) || (isMember(projectId) && resource.data.authorUid == request.auth.uid && request.resource.data.authorUid == resource.data.authorUid);allow delete: if isAdmin(projectId) || (isMember(projectId) && resource.data.authorUid == request.auth.uid);}
  }
 }
}